# ==================================
# DATABASE CONFIGURATION
# ==================================
# Main database URL for Prisma (connection pooling enabled)
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true&connect_timeout=15"

# Direct database connection (no pooling) - used for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@host:port/database"

# ==================================
# AUTHENTICATION (BETTER-AUTH)
# ==================================
# Secret key for Better-Auth (generate a random string)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-random-secret-key-min-32-chars"

# Base URL for authentication callbacks
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-domain.com"

# ==================================
# GOOGLE OAUTH CONFIGURATION
# ==================================
# Get these from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==================================
# EMAIL SERVICE (RESEND)
# ==================================
# Get API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"

# Sender email address (must be verified domain in Resend)
FROM_EMAIL="noreply@yourdomain.com"

# ==================================
# CRON JOB SECURITY
# ==================================
# Secret for authenticating cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET="your-random-cron-secret-key"

# ==================================
# OPTIONAL: ENVIRONMENT
# ==================================
# NODE_ENV="production"

# {
#     "path": "/api/cron/birthday-events",
#        "schedule": "0 0 1 1 *"
#  }

# ==============================================
# WHATSAPP NOTIFICATIONS (CHOWSIGNAL WORKER)
# ==============================================
# Optional. When set, publishing a food menu and the daily food reminder
# cron DM employees on WhatsApp through the ChowSignal worker.
WHATSAPP_WORKER_URL="https://wa.your-domain.com"
# Must match WORKER_SECRET in the worker's .env
WHATSAPP_WORKER_SECRET="your-worker-secret"
# Prefix for local numbers stored with a leading 0 (233 = Ghana)
WHATSAPP_DEFAULT_COUNTRY_CODE="233"
# Optional, testing only: comma-separated numbers; only these receive DMs
# WHATSAPP_TEST_ALLOWLIST="233200000000"
